# ==========================================
# PixelForge Environment Variables
# ==========================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Railway provides this)
DATABASE_URL=postgresql://user:password@localhost:5432/pixelforge

# Redis (Railway provides this)
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=your-super-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Services
RUNWARE_API_KEY=your-runware-api-key

# Replicate (for animations - Phase 4)
REPLICATE_API_TOKEN=

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pixelforge
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Stripe Payments (Phase 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
